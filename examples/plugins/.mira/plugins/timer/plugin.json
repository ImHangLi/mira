{
  "api": 1, "id": "timer", "name": "Timer", "description": "A countdown in the Timer view, with a macOS notification at the end.",
  "entry": {"argv": ["python3", "main.py"]},
  "actions": [
    {"id": "start", "title": "Start timer", "description": "Count down, then notify.", "mode": "task", "run": {"kind": "plugin"},
     "input_schema": {"type": "object", "properties": {
       "seconds": {"type": "integer", "minimum": 1, "maximum": 7200, "default": 300},
       "label": {"type": "string", "default": "Break", "maxLength": 60, "pattern": "^[^\"\\\\]*$"}}, "additionalProperties": false}}
  ],
  "views": [{"id": "clock", "title": "Timer", "kind": "text"}]
}
